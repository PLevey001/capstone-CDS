# Optional repo-root .env. Shell variables win. Values are literal, never evaluated.
# Plain KEY=value; blank/comment lines; optional matching single/double quote wrapper.
# No interpolation, escapes, shell commands, export prefix or inline comments.
CDS_DATA_DIR=data
CDS_AI_URL=http://127.0.0.1:11434
CDS_AI_MODEL=llama3.2:3b
# Supported context range: 8192 through 32768 tokens.
CDS_AI_CONTEXT=8192
CDS_AI_TIMEOUT=180
# Optional: start only this existing user service. Unset by default; no auto installation.
# CDS_AI_SERVICE=cds-ollama.service
# Other supported keys (defaults shown):
# CDS_WORKERS=2
# CDS_MAX_UPLOAD_BYTES=4294967296
# CDS_MAX_ARTIFACTS=20000
# CDS_TOOL_TIMEOUT=90
